# Auren Digital — Environment Configuration

# Server Port
PORT=5000

# Agency Identity
AGENCY_NAME="Auren Digital"
AGENCY_EMAIL="hello@aurendigital.com"
AGENCY_WHATSAPP="7066593251"

# CORS Allowed Origins (Comma separated for multiple, or '*' for open development)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5000"

# Production SMTP Email Configuration (Nodemailer / Resend)
# If left blank, the server operates in Development Mode and logs submissions cleanly to terminal.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
